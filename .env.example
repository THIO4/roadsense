# Copy to .env and adjust. .env is gitignored; this file documents every variable.

# --- Digitraffic ---
# Digitraffic asks clients to identify themselves with this header (no API key needed).
DIGITRAFFIC_USER=RoadSense-Student/0.1
DIGITRAFFIC_BASE_URL=https://tie.digitraffic.fi

# --- App ---
LOG_LEVEL=INFO

# --- Azure Cosmos DB (cloud database) ---
# Get both from:  az cosmosdb show / az cosmosdb keys list  (see infra/azure-setup.sh)
# COSMOS_KEY is a SECRET: never commit it, never paste it in the report.
COSMOS_ENDPOINT=https://<account-name>.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=roadsense
